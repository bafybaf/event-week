{
  "expo": {
    "name": "Event Week",
    "slug": "event-week",
    "owner": "bafybaf06",
    "version": "1.0.0",
    "runtimeVersion": "57.0.0",
    "orientation": "portrait",
    "scheme": "eventweek",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.eventweek",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2BB6E8"
      },
      "package": "com.yourcompany.eventweek",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.NOTIFICATIONS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafınızı seçmek için galeri izni gerekir."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1e40af",
          "defaultChannel": "event-week",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "apiUrl": "http://xcnmst8cowlxzcnc24jgwofs.76.13.14.253.sslip.io/api",
      "eas": {
        "projectId": "1569b470-2b00-4408-b31c-73172ece9800"
      }
    }
  }
}
