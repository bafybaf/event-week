# Coolify Environment Variables
# Docker Compose resource'a bu değerleri ekleyin.

USE_SQLITE=false
DB_NAME=event_week
DB_USER=eventweek
DB_PASSWORD=güçlü-bir-sifre

JWT_SECRET=güçlü-bir-jwt-secret
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@eventweek.com
ADMIN_PASSWORD=güçlü-admin-sifre

# Backend public URL (mobil uygulama ve dosya linkleri)
# Coolify'da backend servisine bağladığınız domain
BACKEND_PUBLIC_URL=https://api.sizin-domain.com

# Admin panelinin tarayıcıdan konuşacağı API adresi.
# Boş bırakırsanız admin kendi domain'i üzerinden /api proxy kullanır.
# Ayrı API domain'iniz varsa doldurun, sonda /api olmasın.
REACT_APP_API_URL=https://api.sizin-domain.com

# Admin (ve gerekirse diğer web origin'ler), virgülle ayırın
CORS_ORIGINS=https://admin.sizin-domain.com
