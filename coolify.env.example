# Coolify Environment Variables
# Docker Compose resource'a bu değerleri ekleyin.

USE_SQLITE=false
DB_NAME=event_week
DB_USER=eventweek
DB_PASSWORD=güçlü-bir-sifre

JWT_SECRET=güçlü-bir-jwt-secret
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@eventweek.com
ADMIN_PASSWORD=güçlü-admin-sifre

# Admin nginx /api /uploads /health'i backend'e proxy'ler.
# Backend domain'i 404 verirse üçüne de admin URL'sini yazın.
BACKEND_PUBLIC_URL=https://admin.sizin-domain.com
REACT_APP_API_URL=https://admin.sizin-domain.com
CORS_ORIGINS=https://admin.sizin-domain.com
